# ==============================================================================
# Shopify App Starter Pro - Environment Configuration
# ==============================================================================

# Shopify App Credentials (Obtain from your Shopify Partner Dashboard)
SHOPIFY_API_KEY=<your-shopify-api-key>
SHOPIFY_API_SECRET=<your-shopify-api-secret>
SHOPIFY_APP_URL=https://<your-app-tunnel-domain>.example.com
SHOPIFY_API_VERSION=2025-01
SHOPIFY_SCOPES=read_products,write_products,read_orders

# Application Info
APP_NAME=Shopify App Starter Pro
APP_HANDLE=shopify-app-starter-pro

# Database Connection URL
# SQLite is configured by default for effortless zero-config development.
# For production (PostgreSQL / MySQL), replace with:
# postgresql://<user>:<password>@<host>:5432/<dbname>?schema=public
DATABASE_URL="file:./dev.db"

# App Proxy Settings (For storefront extensions)
APP_PROXY_PREFIX=apps
APP_PROXY_SUBPATH=starter-proxy

# Local Development & Offline Mock Mode
# Set to 'true' to run and test embedded dashboards, session verification,
# and webhook mockers locally without active Shopify partner credentials or tunnel.
LOCAL_SANDBOX_MODE=true
