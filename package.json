{
  "name": "shopify-app-starter-pro",
  "version": "1.0.0",
  "description": "Production-ready modern Shopify embedded app boilerplate with Next.js, Prisma, multi-shop support and local developer sandbox.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "config:generate": "node scripts/generate-toml.mjs",
    "test": "node test/run-tests.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.14.0",
    "typescript": "^5.4.5"
  }
}
